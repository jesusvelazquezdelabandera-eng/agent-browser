# Copia este archivo a .env y ajusta los valores.

# --- Empresa y agente ---
AGENTE_NOMBRE=Álex
EMPRESA_NOMBRE=Banpi Domótica
EMPRESA_CIUDAD=Sevilla
EMPRESA_TELEFONO=
EMPRESA_WEB=
EMPRESA_ZONA=Sevilla y provincia
EMPRESA_SERVICIOS=automatización de persianas y toldos, iluminación inteligente, climatización, alarmas y videovigilancia, y control desde el móvil

# --- Modelo de lenguaje (Ollama) ---
# LLM_BACKEND=plantillas usa frases fijas sin modelo (útil para probar)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURA=0.4
# Segundos máximos de espera a la primera frase del LLM antes de usar la frase de respaldo
LLM_TIMEOUT_PRIMERA_S=2.5

# --- Reconocimiento de voz (faster-whisper) ---
# En CPU sin GPU, "base" cumple mejor el objetivo de latencia que "small".
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# --- Síntesis de voz (Piper) ---
PIPER_VOICE=es_ES-davefx-medium
PIPER_CUDA=false

# --- Detección de voz ---
VAD_BACKEND=webrtc
VAD_AGRESIVIDAD=2
VAD_SILENCIO_FIN_MS=600
BARGE_IN_MS=250

# --- Telefonía (Asterisk ARI) ---
TELEFONIA_BACKEND=asterisk
ARI_URL=http://127.0.0.1:8088
ARI_USUARIO=banpi
ARI_PASSWORD=cambia-esta-clave
ARI_APP=banpi
SIP_ENDPOINT=PJSIP/{numero}@troncal
# nacional (600112233), e164 (+34600112233), internacional (0034600112233) o sin_mas (34600112233)
SIP_FORMATO_NUMERO=nacional
# Número que verá el cliente. Revisa si tu empresa debe usar el prefijo 400 (ver README).
CALLER_ID=
RTP_HOST_LOCAL=127.0.0.1
RTP_PUERTO_INICIO=40000
RTP_PUERTO_FIN=40100

# --- Cumplimiento y campañas ---
ZONA_HORARIA=Europe/Madrid
HORA_INICIO=9
HORA_FIN=21
MAX_INTENTOS=3
VENTANA_INTENTOS_DIAS=7
REINTENTO_MINUTOS=120
LLAMADAS_SIMULTANEAS=1
ROBINSON_FILE=data/robinson.txt
FESTIVOS_EXTRA_FILE=data/festivos_extra.txt
GRABAR_LLAMADAS=true
WORKER_ACTIVO=true

# --- Conversación ---
MAX_TURNOS=20
MAX_DURACION_S=300

# --- Panel web ---
PANEL_HOST=127.0.0.1
PANEL_PUERTO=8000
# Si defines usuario y contraseña, el panel pide autenticación básica.
PANEL_USUARIO=
PANEL_PASSWORD=
